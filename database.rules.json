{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[A-F0-9]{6}$/)",
        ".write": "auth != null && !data.exists() && newData.child('host/uid').val() === auth.uid && !newData.child('guest').exists()",
        ".validate": "newData.hasChildren(['mode','created','categories','host']) && (newData.child('mode').val() === 'battle' || newData.child('mode').val() === 'real')",
        "host": {
          "ready": {
            ".write": "auth != null && data.parent().child('uid').val() === auth.uid && data.val() === false && newData.val() === true"
          },
          "moves": {
            "$round": {
              ".write": "auth != null && data.parent().parent().child('uid').val() === auth.uid && !data.exists() && newData.hasChildren(['hash']) && !newData.child('reveal').exists()",
              "reveal": {
                ".write": "auth != null && data.parent().parent().parent().child('uid').val() === auth.uid && !data.exists() && data.parent().child('hash').exists() && root.child('rooms').child($code).child('guest/moves').child($round).child('hash').exists()"
              }
            }
          }
        },
        "guest": {
          ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms').child($code).child('host/uid').val() !== auth.uid && newData.child('ready').val() === false && !newData.child('moves').exists()",
          "ready": {
            ".write": "auth != null && data.parent().child('uid').val() === auth.uid && data.val() === false && newData.val() === true"
          },
          "moves": {
            "$round": {
              ".write": "auth != null && data.parent().parent().child('uid').val() === auth.uid && !data.exists() && newData.hasChildren(['hash']) && !newData.child('reveal').exists()",
              "reveal": {
                ".write": "auth != null && data.parent().parent().parent().child('uid').val() === auth.uid && !data.exists() && data.parent().child('hash').exists() && root.child('rooms').child($code).child('host/moves').child($round).child('hash').exists()"
              }
            }
          }
        }
      }
    },
    "playerSaves100": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous' && newData.exists()",
        ".validate": "newData.hasChildren(['rev','payload','time']) && newData.child('rev').isNumber() && newData.child('rev').val() === (data.exists() ? data.child('rev').val() + 1 : 1) && newData.child('payload').isString() && newData.child('payload').val().length <= 4000000 && newData.child('time').isNumber()",
        "backups": {
          "$day": {
            ".validate": "newData.hasChildren(['payload','time']) && newData.child('payload').isString() && newData.child('payload').val().length <= 4000000 && newData.child('time').isNumber()"
          }
        }
      }
    },
    "publicProfiles103": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && query.limitToLast != null && query.limitToLast <= 50 && (query.orderByChild === 'xp' || query.orderByChild === 'lp' || query.orderByChild === 'cars' || query.orderByChild === 'wins' || query.orderByChild === 'online')",
      ".indexOn": [
        "xp",
        "lp",
        "cars",
        "wins",
        "online"
      ],
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid",
        ".validate": "newData.hasChildren([\"name\", \"brand\", \"avatar\", \"level\", \"xp\", \"lp\", \"cars\", \"wins\", \"losses\", \"online\", \"onlineLosses\", \"draws\", \"updated\"])",
        "name": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-zA-Z0-9 _-]{3,24}$/)"
        },
        "brand": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "avatar": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 11"
        },
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
        },
        "xp": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "lp": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "cars": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1500"
        },
        "wins": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "losses": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "online": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "onlineLosses": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "draws": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "updated": {
          ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms91": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[A-F0-9]{6}$/)",
        ".write": "auth != null && !data.exists() && newData.child('host/uid').val() === auth.uid && !newData.child('guest').exists()",
        ".validate": "newData.hasChildren(['mode','created','categories','host']) && (newData.child('mode').val() === 'battle' || newData.child('mode').val() === 'real')",
        "host": {
          "ready": {
            ".write": "auth != null && data.parent().child('uid').val() === auth.uid && data.val() === false && newData.val() === true"
          },
          "moves": {
            "$round": {
              ".write": "auth != null && data.parent().parent().child('uid').val() === auth.uid && !data.exists() && newData.hasChildren(['hash']) && !newData.child('reveal').exists()",
              "reveal": {
                ".write": "auth != null && data.parent().parent().parent().child('uid').val() === auth.uid && !data.exists() && data.parent().child('hash').exists() && root.child('rooms91').child($code).child('guest/moves').child($round).child('hash').exists()"
              }
            }
          }
        },
        "guest": {
          ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms91').child($code).child('host/uid').val() !== auth.uid && newData.child('ready').val() === false && !newData.child('moves').exists()",
          "ready": {
            ".write": "auth != null && data.parent().child('uid').val() === auth.uid && data.val() === false && newData.val() === true"
          },
          "moves": {
            "$round": {
              ".write": "auth != null && data.parent().parent().child('uid').val() === auth.uid && !data.exists() && newData.hasChildren(['hash']) && !newData.child('reveal').exists()",
              "reveal": {
                ".write": "auth != null && data.parent().parent().parent().child('uid').val() === auth.uid && !data.exists() && data.parent().child('hash').exists() && root.child('rooms91').child($code).child('host/moves').child($round).child('hash').exists()"
              }
            }
          }
        }
      }
    }
  }
}
